# Frontend runtime
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
# Legacy fallback, kept for compatibility with older setups:
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_ENABLE_GITHUB_OAUTH=false

# Supabase CLI auth provider secrets
# Leave these empty unless you enable the provider blocks in supabase/config.toml.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
